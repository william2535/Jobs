    "android:prepare": "node scripts/prepare-android.mjs",
    "android:bundle": "node scripts/build-android.mjs bundle",
    "android:apk": "node scripts/build-android.mjs apk",
    "android:release": "node scripts/build-android.mjs release"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "^21.0.4",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
